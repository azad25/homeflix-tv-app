<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black, chrome-less base: no white flash between launcher and first frame. -->
    <style name="Theme.HomeFlixTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/netflix_red</item>
        <item name="android:colorAccent">@color/netflix_red</item>
        <item name="android:colorBackground">@color/netflix_black</item>
        <item name="android:windowBackground">@color/netflix_black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.HomeFlixTV.NoActionBar" />

    <!-- Launch theme: shows the HomeFlix icon on black while Home warms up. -->
    <style name="Theme.HomeFlixTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/netflix_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.HomeFlixTV.NoActionBar</item>
    </style>
</resources>
